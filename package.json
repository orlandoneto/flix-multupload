{
  "name": "flixdesign-front",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend FlixDesign make on Reacjs",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "cross-env NODE_ENV=test VITE_ENV=test vite --mode test",
    "dev": "cross-env NODE_ENV=development VITE_ENV=development vite --mode development",
    "dev:electron": "cross-env NODE_ENV=development VITE_ENV=development concurrently \"vite --mode development\" \"wait-on tcp:3000 && electron .\"",
    "test:electron": "cross-env NODE_ENV=test VITE_ENV=test concurrently \"vite --mode test\" \"wait-on tcp:3000 && electron .\"",
    "prod": "cross-env NODE_ENV=production VITE_ENV=production vite --mode production",
    "build": "cross-env NODE_ENV=production VITE_ENV=production tsc -b && vite build",
    "build:dev": "cross-env NODE_ENV=development VITE_ENV=development tsc -b && vite build --mode development --outDir dist-dev",
    "build:test": "cross-env NODE_ENV=test VITE_ENV=test tsc -b && vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "start": "electron .",
    "preview:dev": "vite preview --outDir dist-dev",
    "preview:test": "vite preview --outDir dist-test",
    "clean": "rimraf dist dist-dev dist-test",
    "clean:dev": "rimraf dist-dev",
    "clean:prod": "rimraf dist",
    "clean:test": "rimraf dist-test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\""
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@mui/material": "^6.1.5",
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^4.5.0",
    "@uppy/core": "^4.5.3",
    "@uppy/drag-drop": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^4.5.2",
    "axios": "^1.7.2",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "masonic": "^4.1.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-easy-crop": "^5.5.0",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.52.1",
    "react-i18next": "^15.6.1",
    "react-icons": "^5.4.0",
    "react-input-mask": "^2.0.4",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router-dom": "^6.24.0",
    "react-select": "^5.8.2",
    "react-share": "^5.1.0",
    "react-slick": "^0.31.0",
    "react-spinners-kit": "^1.9.1",
    "react-tagsinput": "^3.20.3",
    "react-toastify": "^10.0.5",
    "recharts": "^2.15.1",
    "slick-carousel": "^1.8.1",
    "styled-components": "5.3.10",
    "swiper": "^11.2.10",
    "uuid": "^10.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-input-mask": "^3.0.5",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@types/react-slick": "^0.23.13",
    "@types/react-tagsinput": "^3.20.6",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-plugin-styled-components": "^2.1.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^6.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-tsconfig-paths": "^5.0.1",
    "concurrently": "^9.1.0",
    "electron": "^32.1.2",
    "wait-on": "^7.2.0"
  }
}